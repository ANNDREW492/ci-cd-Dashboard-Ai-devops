# FRONTEND (.env.local - development)

# URL del backend usado en src/services/apiClient.js
VITE_BACKEND_URL=http://localhost:3000

# BACKEND (backend-api/.env)

# Puerto del servidor
PORT=3000

# MongoDB Atlas
MONGO_URI=mongodb+srv://usuario:contrasena@cluster.mongodb.net/ci-cd-dashboard

# JWT
JWT_SECRET=tu-super-secreto-cambiar-en-produccion
JWT_EXPIRY=24h

# URL del servicio de IA (FastAPI)
AI_SERVICE_URL=http://127.0.0.1:8000

# AWS S3 para datasets/modelos
# En local van en backend-api/.env; en GitHub Actions van como Secrets.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=pro8-model-artifacts-anndrew

# GitHub Actions workflow_dispatch desde el backend
# GH_PAT debe tener permisos para Actions/workflows en senatibuho/pro8.
GH_PAT=
GITHUB_OWNER=senatibuho
GITHUB_REPO=pro8
GITHUB_BRANCH=ci/cd-proyecto
GITHUB_WORKFLOW_FILE=retrain.yml

# Token opcional para que un workflow notifique /api/ml/mark-promoted
ML_WEBHOOK_TOKEN=

# AI Service
OPENAI_API_KEY=
CATBOOST_MODEL_PATH=catboost_despliegues_v3.cbm
