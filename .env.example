# FRONTEND (.env.local - development)

# URL del backend (usado en src/services/apiClient.js)
VITE_BACKEND_URL=http://localhost:3000

# BACKEND (backend-api/.env - production)

# Puerto del servidor
PORT=3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/ci-cd-dashboard

# JWT
JWT_SECRET=tu-super-secreto-cambiar-en-produccion-ahora-mismo
JWT_EXPIRY=24h

# URL del servicio de IA (FastAPI)
AI_SERVICE_URL=http://127.0.0.1:8000

# NOTAS PARA AWS/PRODUCCIÓN
# Frontend:
#   - Cambiar VITE_BACKEND_URL al dominio/IP de tu backend en AWS
#   - Ejemplo: VITE_BACKEND_URL=https://api.tudominio.com
#
# Backend:
#   - Usar variables de entorno del sistema para JWT_SECRET (más seguro)
#   - Usar connection string real de MongoDB Atlas
#   - Configurar CORS para el dominio del frontend
#   - Usar HTTPS en producción
#
# AI Service:
#   - Configurar OPENAI_API_KEY en variables de entorno del sistema
#   - Asegurar CORS para que frontend pueda llamar (http://localhost:5173 en dev)
